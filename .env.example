# ─────────────────────────────────────────────────────────────
# Chainlink US Government Macroeconomic Data Collector
# Copy this file to .env and fill in your RPC URLs.
# All reads are view-only — no private key is required.
# ─────────────────────────────────────────────────────────────

# ── RPC Endpoints ────────────────────────────────────────────
# Include only the networks you want to poll.
# Free public RPCs work for these low-frequency feeds (monthly/quarterly).

RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_AVALANCHE=https://avalanche-mainnet.infura.io/v3/YOUR_KEY
RPC_ZKSYNC=https://mainnet.era.zksync.io
RPC_LINEA=https://linea-mainnet.infura.io/v3/YOUR_KEY
RPC_MANTLE=https://rpc.mantle.xyz
RPC_SONIC=https://rpc.soniclabs.com
RPC_BOTANIX=https://node.botanixlabs.dev

# ── Scheduler ────────────────────────────────────────────────
# Cron expression for the polling daemon.
# Default: every day at 09:00 UTC.
# Feeds only change monthly/quarterly so daily polling is sufficient.
POLL_INTERVAL_CRON=0 9 * * *

# ── Storage ──────────────────────────────────────────────────
OUTPUT_DIR=./data

# ── Logging ──────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info

# ── L2 Safety ────────────────────────────────────────────────
# Minimum seconds the L2 sequencer must have been live before trusting data.
# Chainlink recommendation: 3600 (1 hour)
L2_GRACE_PERIOD_SECONDS=3600

# ── Staleness Thresholds ─────────────────────────────────────
# Maximum age (in days) before a feed value is flagged as stale.
# PCE updates monthly; GDP updates quarterly.
STALE_THRESHOLD_MONTHLY_DAYS=35
STALE_THRESHOLD_QUARTERLY_DAYS=95
