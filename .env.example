# ─── Contact Form ────────────────────────────────────────────────────────────
# SMTP configuration for sending contact form submissions via email.
# If left empty, form submissions are logged to the server console (stub mode).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=hello@atlas-labs.ai

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://atlas-labs.ai
